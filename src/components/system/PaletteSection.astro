---
import { sectionLabels, swatches } from "@/data/identity";
---

<section class="palette" aria-labelledby="palette-label">
   <h2 id="palette-label" class="ss label">
      {sectionLabels.palette}
   </h2>

   <ul class="swatches">
      {swatches.map((swatch) => (
         <li class="swatch">
            <div class="chip" style={`background: var(${swatch.token})`} aria-hidden="true" />
            <span class="name">{swatch.name}</span>
            <span class="ss hex">{swatch.hex}</span>
            <span class="role">{swatch.role}</span>
            <span class="ss contrast">{swatch.contrast}</span>
         </li>
      ))}
   </ul>
</section>

<style>
   .palette {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 16px;
   }

   .label {
      font-size: 11px;
      font-weight: 400;
      color: var(--violet-link);
   }

   .swatches {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   .swatch {
      display: flex;
      flex-direction: column;
      gap: 10px;
   }

   .chip {
      height: 120px;
      box-shadow: inset 0 0 0 1px var(--rule);
   }

   .name {
      font-size: 15px;
      font-weight: 600;
   }

   .hex {
      font-size: 11px;
      color: var(--graphite);
   }

   .role {
      font-size: 13px;
      line-height: 1.4;
      color: var(--ink);
   }

   .contrast {
      font-size: 10px;
      color: var(--violet-link);
   }

   @media (max-width: 1100px) {
      .swatches {
         grid-template-columns: repeat(4, minmax(0, 1fr));
         row-gap: 28px;
      }
   }

   @media (max-width: 700px) {
      .swatches {
         grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .chip {
         height: 88px;
      }
   }
</style>
