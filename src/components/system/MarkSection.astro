---
import Mark from "@/components/ui/Mark.astro";
import { markGrounds, markRationale, markSizes, sectionLabels } from "@/data/identity";
---

<section class="mark" aria-labelledby="mark-label">
   <h2 id="mark-label" class="ss label">
      {sectionLabels.mark}
   </h2>

   <ul class="grounds">
      {markGrounds.map((ground) => (
         <li
            class:list={["ground", { dark: ground.dark }]}
            style={`background: var(${ground.token})`}
         >
            <Mark width={132} glow={false} />
            <span class="ss caption">{ground.name}</span>
         </li>
      ))}
   </ul>

   <div class="small-sizes">
      <ul class="sizes">
         {markSizes.map((size) => (
            <li>
               <Mark width={size} glow={false} />
               <span class="ss size">{size} px</span>
            </li>
         ))}
      </ul>
      <p class="rationale">{markRationale}</p>
   </div>
</section>

<style>
   .mark {
      display: flex;
      flex-direction: column;
      gap: 18px;
   }

   .label {
      font-size: 11px;
      font-weight: 400;
      color: var(--violet-link);
   }

   .grounds {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   .ground {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 18px;
      height: 190px;
      padding: 0 8px;
      text-align: center;
      border: 1px solid var(--titanium);
   }

   .ground.dark {
      border-color: var(--violet-signal);
   }

   .caption {
      font-size: 10px;
      color: var(--ink);
   }

   .dark .caption {
      color: var(--on-dark);
   }

   .small-sizes {
      display: flex;
      align-items: center;
      gap: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--titanium);
   }

   .sizes {
      display: flex;
      align-items: flex-end;
      gap: 20px;
      flex: none;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   .sizes li {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
   }

   .size {
      font-size: 10px;
      color: var(--ink-muted);
   }

   .rationale {
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
   }

   @media (max-width: 700px) {
      .ground {
         height: 140px;
      }

      .ground :global(img) {
         width: 72px;
      }

      .small-sizes {
         flex-wrap: wrap;
      }
   }
</style>
