---
import Monogram from "@/components/ui/Monogram.astro";
import { markCandidates, markRationale, sectionLabels } from "@/data/identity";
---

<section class="mark" aria-labelledby="mark-label">
   <h2 id="mark-label" class="ss label">
      {sectionLabels.mark}
   </h2>

   <ul class="candidates">
      {markCandidates.map((candidate) => (
         <li class:list={["candidate", { chosen: candidate.chosen }]}>
            <span role="img" aria-label={`Mark ${candidate.id}`} class="glyph">
               {candidate.id === "A" && (
                  <Monogram width={96} stroke="var(--ceramic)" via="var(--violet-glow)" />
               )}
               {candidate.id === "B" && (
                  <svg width="96" height="76" viewBox="0 0 40 32" aria-hidden="true">
                     <path
                        class="trace"
                        d="M4 28V10a4 4 0 0 1 6.8-2.8L20 16l9.2-8.8A4 4 0 0 1 36 10v18"
                     />
                     <circle class="via" cx="20" cy="16" r="2.4" />
                  </svg>
               )}
               {candidate.id === "C" && (
                  <svg width="96" height="76" viewBox="0 0 40 32" aria-hidden="true">
                     <g class="pins">
                        <rect x="3" y="6" width="4" height="22" />
                        <rect x="15" y="6" width="4" height="22" />
                        <rect x="21" y="6" width="4" height="22" />
                        <rect x="33" y="6" width="4" height="22" />
                     </g>
                     <path class="pin-trace" d="M7 8l4 6 4-6M25 8l4 6 4-6" />
                  </svg>
               )}
            </span>
            <span class="ss caption">{candidate.caption}</span>
         </li>
      ))}
   </ul>

   <div class="small-sizes">
      <svg width="16" height="13" viewBox="0 0 40 32" aria-hidden="true">
         <path class="small-trace heavy" d="M4 28V6l8 8 8-8 8 8 8-8v22"></path>
         <circle class="via" cx="20" cy="26" r="3.5"></circle>
      </svg>
      <svg width="32" height="26" viewBox="0 0 40 32" aria-hidden="true">
         <path class="small-trace" d="M4 28V6l8 8 8-8 8 8 8-8v22"></path>
         <path class="small-trace" d="M20 6v16"></path>
         <circle class="via" cx="20" cy="26" r="3"></circle>
      </svg>
      <p class="rationale">{markRationale}</p>
   </div>
</section>

<style>
   .mark {
      display: flex;
      flex-direction: column;
      gap: 18px;
   }

   .label {
      font-size: 11px;
      font-weight: 400;
      color: var(--violet-link);
   }

   .candidates {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   .candidate {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      height: 170px;
      padding: 0 8px;
      background: var(--substrate);
      text-align: center;
   }

   .candidate.chosen {
      background: var(--graphite);
      box-shadow: 0 0 0 2px var(--violet-signal);
   }

   .glyph {
      display: flex;
   }

   .trace,
   .small-trace {
      fill: none;
      stroke: var(--graphite);
      stroke-width: 2.5;
   }

   .small-trace {
      stroke-width: 3;
   }

   .small-trace.heavy {
      stroke-width: 4;
   }

   .via {
      fill: var(--violet-signal);
   }

   .pins {
      fill: var(--graphite);
   }

   .pin-trace {
      fill: none;
      stroke: var(--violet-signal);
      stroke-width: 1.6;
   }

   .caption {
      font-size: 10px;
      color: var(--ink);
   }

   .chosen .caption {
      color: var(--on-dark);
   }

   .small-sizes {
      display: flex;
      align-items: center;
      gap: 24px;
      padding-top: 16px;
      border-top: 1px solid var(--titanium);
   }

   .small-sizes svg {
      flex: none;
   }

   .rationale {
      font-size: 14px;
      line-height: 1.5;
      color: var(--ink);
   }

   @media (max-width: 700px) {
      .candidate {
         height: 140px;
      }

      .glyph :global(svg) {
         width: 64px;
         height: 51px;
      }

      .small-sizes {
         flex-wrap: wrap;
      }
   }
</style>
