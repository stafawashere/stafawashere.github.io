---
import CircuitGlyph from "./CircuitGlyph.astro";
import { circuitTerms, sectionLabels } from "@/data/identity";
---

<section class="circuit" aria-labelledby="circuit-label">
   <h2 id="circuit-label" class="ss label">
      {sectionLabels.circuit}
   </h2>

   <ul class="terms">
      {circuitTerms.map((term) => (
         <li class="term">
            <div
               class:list={["tile", term.surface, { brushed: term.surface === "brushed-graphite" }]}
            >
               <CircuitGlyph kind={term.kind} />
            </div>
            <span class="name">{term.name}</span>
            <span class="note">{term.note}</span>
         </li>
      ))}
   </ul>
</section>

<style>
   .circuit {
      display: flex;
      flex-direction: column;
      gap: 18px;
   }

   .label {
      font-size: 11px;
      font-weight: 400;
      color: var(--violet-link);
   }

   .terms {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      row-gap: 20px;
      margin: 0;
      padding: 0;
      list-style: none;
   }

   .term {
      display: flex;
      flex-direction: column;
      gap: 8px;
   }

   .tile {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 96px;
      padding: 0 8px;
      background-color: var(--substrate);
   }

   .tile.graphite,
   .tile.brushed-graphite {
      background-color: var(--graphite);
   }

   .tile.ceramic {
      background-color: var(--ceramic);
      box-shadow: inset 0 0 0 1px var(--rule);
   }

   .name {
      font-size: 14px;
      font-weight: 600;
   }

   .note {
      font-size: 12px;
      color: var(--ink);
   }

   @media (max-width: 700px) {
      .terms {
         grid-template-columns: repeat(2, minmax(0, 1fr));
      }
   }
</style>
