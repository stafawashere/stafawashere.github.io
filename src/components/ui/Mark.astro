---
import { Image } from "astro:assets";
import mark from "@/assets/brand/mark.png";

interface Props {
   width?: number;
   glow?: boolean;
}

const { width = 44, glow = true } = Astro.props;
---

<span class="frame">
   <Image
      src={mark}
      alt=""
      width={width}
      densities={[1, 2]}
      format="webp"
      class:list={["mark", { glow }]}
      aria-hidden="true"
   />
</span>

<style>
   .frame {
      display: inline-flex;
      flex: none;
   }

   .mark {
      display: block;
      height: auto;
   }

   .glow {
      filter: drop-shadow(0 4px 10px rgb(120 98 189 / 0.28));
      transition: filter var(--dur-signal) var(--ease-signal);
   }

   :global(a:hover) .glow {
      filter: drop-shadow(0 4px 14px rgb(120 98 189 / 0.5));
   }
</style>
