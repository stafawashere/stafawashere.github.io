---
interface Props {
   width?: number;
   stroke?: string;
   via?: string;
   withPads?: boolean;
}

const {
   width = 40,
   stroke = "var(--graphite)",
   via = "var(--violet-signal)",
   withPads = true,
} = Astro.props;
const height = Math.round((width * 32) / 40);
---

<svg {width} {height} viewBox="0 0 40 32" aria-hidden="true">
   <path d="M4 28V6l8 8 8-8 8 8 8-8v22" fill="none" stroke={stroke} stroke-width="2.5"></path>
   <path d="M20 6v16" fill="none" stroke={stroke} stroke-width="2.5"></path>
   <circle cx="20" cy="26" r="2.6" fill={via}></circle>
   {withPads && (
      <>
         <circle cx="4" cy="28.5" r="2.2" fill={stroke} />
         <circle cx="36" cy="28.5" r="2.2" fill={stroke} />
      </>
   )}
</svg>
