---
import { strands } from "@/data/profile";
---

<nav class="bus" aria-label="Three strands of work">
   {strands.map((strand) => (
      <a href={strand.href}>
         <span class="via" aria-hidden="true" />
         <span class="ss code">
            {strand.code} · {strand.label}
         </span>
         <span class="title">{strand.title}</span>
         <span class="summary">{strand.summary}</span>
      </a>
   ))}
</nav>

<style>
   .bus {
      position: relative;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
   }

   .bus a {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 22px 24px 26px;
      border-top: 1.5px solid var(--graphite);
      color: var(--graphite);
   }

   .bus a:first-child {
      padding-left: 0;
   }

   .bus a:last-child {
      padding-right: 0;
   }

   .bus a + a {
      border-left: 1px solid var(--titanium);
   }

   .via {
      position: absolute;
      left: 24px;
      top: -5px;
      width: 8px;
      height: 8px;
      background: var(--graphite);
      transition:
         background-color var(--dur-fast) ease,
         transform var(--dur-fast) ease;
   }

   .bus a:first-child .via {
      left: 0;
   }

   .bus a:hover .via {
      background: var(--violet-signal);
      transform: scale(1.3);
   }

   .code {
      font-size: 11px;
      color: var(--violet-link);
      padding-top: 4px;
   }

   .title {
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
   }

   .summary {
      font-size: 14px;
      color: var(--ink);
   }

   @media (max-width: 700px) {
      .bus {
         grid-template-columns: 1fr;
      }

      .bus a,
      .bus a:first-child,
      .bus a:last-child {
         padding-left: 0;
         padding-right: 0;
      }

      .bus a + a {
         border-left: 0;
      }

      .via {
         left: 0;
      }
   }
</style>
