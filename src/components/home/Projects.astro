---
import { Image } from "astro:assets";
import ProjectIndex from "./ProjectIndex.astro";
import ProjectSource from "@/components/ui/ProjectSource.astro";
import Mark from "@/components/ui/Mark.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import distributionShot from "@/assets/images/projects/distribution-network.webp";
import inspectShot from "@/assets/images/projects/inspect-workflow.webp";
import spicetifyShot from "@/assets/images/projects/spicetify.webp";
import sujoodShot from "@/assets/images/projects/sujood.webp";
import trashyShot from "@/assets/images/projects/trashy-apocalypse.webp";
import { projectById, projectIndex } from "@/data/projects";

const disky = projectById("PRJ-03");
const distribution = projectById("PRJ-04");
const trashy = projectById("PRJ-05");
const inspect = projectById("PRJ-07");
const webappRe = projectById("PRJ-08");
const sujood = projectById("PRJ-09");
const spicetify = projectById("PRJ-06");
const taskbench = projectById("PRJ-10");
const ledger = projectById("PRJ-11");
const portfolio = projectById("PRJ-12");
---

<section id="projects" class="wrap projects">
   <SectionHeading index="03" label="Projects" title="Built from the protocol up." maxCh={16}>
      <a href="#index" class="ss tap all">
         All {projectIndex.length} projects ↘
      </a>
   </SectionHeading>

   <div class="g12 features">
      <article class="s5 card-dark disky">
         <div class="grain grain-layer" aria-hidden="true"></div>
         <div class="ss row-between muted">
            <span>{disky.id} · Python · open source</span>
            <span>{disky.date}</span>
         </div>
         <div class="stat">
            <span class="bigfig">57</span>
            <span class="ss muted">
               event types
               <br />
               parsed from scratch
            </span>
         </div>
         <div class="wire" aria-hidden="true">
            <span class="ss node">Discord</span>
            <span class="line"></span>
            <span class="ss muted">WebSocket + HTTP</span>
            <span class="line"></span>
            <span class="ss node solid">Disky</span>
         </div>
         <div class="body">
            <h3 class="h3">{disky.name}</h3>
            <p>
               A Discord library written over raw WebSockets and HTTP instead of an existing
               wrapper. It handles the connection, heartbeat, reconnects and sessions on its own.
            </p>
         </div>
         <ProjectSource project={disky} />
      </article>

      <article class="s7 signal-card distribution">
         <svg class="trace" aria-hidden="true" viewBox="0 0 800 10" preserveAspectRatio="none">
            <path
               d="M0 5H800"
               stroke="var(--rule)"
               stroke-width="1"
               vector-effect="non-scaling-stroke"
            ></path>
            <path
               class="sig"
               d="M0 5H800"
               stroke="var(--violet-signal)"
               stroke-width="2"
               vector-effect="non-scaling-stroke"
            ></path>
         </svg>
         <figure class="window">
            <div class="chrome">
               <span class="light lit" aria-hidden="true"></span>
               <span class="light" aria-hidden="true"></span>
               <span class="light" aria-hidden="true"></span>
               <figcaption class="ss">FIG. 03 · admin dashboard · real screenshot</figcaption>
            </div>
            <Image
               src={distributionShot}
               alt="Distribution Network admin dashboard: revenue, profit, pending sales, top products and resellers, recent sales and stock movements."
               widths={[640, 960, 1600]}
               sizes="(max-width: 1024px) 100vw, 760px"
               class="shot"
            />
         </figure>
         <div class="split">
            <div class="stack">
               <span class="ss small-muted">
                  {distribution.id} · Full-stack · {distribution.date}
               </span>
               <h3 class="h3">{distribution.name}</h3>
               <span class="ss tech">{distribution.tech}</span>
            </div>
            <div class="stack">
               <p class="ink">
                  Separate portals for a distributor and its resellers: inventory, bulk pricing
                  tiers, sales approval and a revenue dashboard. Every stock change is written in
                  the same transaction as the count, so the history can’t drift.
               </p>
               <ProjectSource project={distribution} />
            </div>
         </div>
      </article>

      <article class="s12 trashy">
         <figure class="game-map">
            <Image
               src={trashyShot}
               alt="Trashy Apocalypse level map: a top-down pixel-art wasteland with stone walls and toxic barrels."
               widths={[450, 900]}
               sizes="(max-width: 700px) calc(100vw - 64px), (max-width: 1024px) calc(58vw - 72px), (max-width: 1360px) calc(58vw - 116px), 680px"
               class="shot pixelated"
            />
            <figcaption class="ss">Level background from the game</figcaption>
         </figure>
         <div class="stack game-body">
            <span class="ss small-muted">
               {trashy.id} · AP CSP team · {trashy.date}
            </span>
            <h3 class="h3 game-title">{trashy.name}</h3>
            <p class="ink">
               A top-down zombie shooter with layered audio and saved high scores, built for our
               school’s annual arts event.
            </p>
            <dl class="game-facts">
               <div>
                  <dt class="ss small-muted">Role</dt>
                  <dd>Lead programmer</dd>
               </div>
               <div>
                  <dt class="ss small-muted">Engine</dt>
                  <dd>Python Arcade</dd>
               </div>
            </dl>
            <ProjectSource project={trashy} />
         </div>
      </article>

      <div class="s12 cluster">
         <div class="ss cluster-head">
            <h3 class="cluster-title">More projects</h3>
         </div>
         <div class="g12 cluster-grid">
            <article class="inspect-project">
               <div class="inspect-header">
                  <div class="stack tight">
                     <span class="ss small-muted">{inspect.id} · Developer tool</span>
                     <h4 class="h4 inspect-title">{inspect.name}</h4>
                  </div>
                  <p class="ink small">
                     Watch Claude Code transcripts update live as Inspect Workflow groups subagents
                     and workflow runs.
                  </p>
               </div>
               <figure class="inspect-preview">
                  <figcaption class="ss stream-caption">Transcript streamed over SSE</figcaption>
                  <Image
                     src={inspectShot}
                     alt="Inspect Workflow showing a Claude Code transcript as a readable conversation with a sidebar of agent runs."
                     widths={[480, 960, 1600]}
                     sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1024px) calc(100vw - 56px), (max-width: 1360px) calc(66.67vw - 53px), 845px"
                     class="shot"
                  />
               </figure>
               <div class="inspect-footer">
                  <span class="ss small-muted">Python standard library · One HTML page</span>
                  <ProjectSource project={inspect} />
               </div>
            </article>

            <article class="s4 spicetify-project">
               <div class="stack tight">
                  <span class="ss project-meta">{spicetify.id} · Spotify client mods</span>
                  <h4 class="h4">{spicetify.name}</h4>
               </div>
               <Image
                  src={spicetifyShot}
                  alt="Spotify desktop with the extensions: album-colored theme, a large cover and a library grid."
                  widths={[480, 960, 1600]}
                  sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1024px) calc(100vw - 56px), (max-width: 1360px) calc(33.33vw - 43px), 411px"
                  class="shot spicetify-shot"
               />
               <div class="stack spicetify-results">
                  <p>
                     I used DevTools to profile and optimize an animation in Spotify’s desktop
                     client.
                  </p>
                  <div class="stack tight spicetify-performance">
                     <span class="ss project-meta">CPU share of one core</span>
                     <div
                        class="cpu"
                        role="img"
                        aria-label="About 50 percent before, 13 percent after"
                     >
                        <span class="ss">Before</span>
                        <span class="track">
                           <span class="fill before"></span>
                        </span>
                        <span class="ss">~50%</span>
                        <span class="ss">After</span>
                        <span class="track">
                           <span class="fill after"></span>
                        </span>
                        <span class="ss result">13%</span>
                     </div>
                  </div>
                  <ProjectSource project={spicetify} />
               </div>
            </article>

            <article class="s5 api-project">
               <div class="stack tight">
                  <span class="ss small-muted">{webappRe.id} · Claude Code plugin</span>
                  <h4 class="h4 api-title">{webappRe.name}</h4>
                  <p class="ink small">
                     Builds an automation program around a web app’s private API.
                  </p>
               </div>
               <dl class="api-scope">
                  <div>
                     <dt class="ss small-muted">Input</dt>
                     <dd>Signed-in web app</dd>
                  </div>
                  <div class="approval">
                     <dt class="ss small-muted">Data-changing requests</dt>
                     <dd>Approval required</dd>
                  </div>
               </dl>
               <ProjectSource project={webappRe} />
            </article>

            <article class="s7 sujood-project">
               <div class="sujood-body">
                  <div class="stack tight">
                     <span class="ss">{sujood.id} · Prayer reference</span>
                     <h4 class="h4 sujood-title">{sujood.name}</h4>
                     <p>
                        The eight positions of salah in order, each with Arabic, transliteration,
                        and recitation audio.
                     </p>
                  </div>
                  <a href={sujood.url} class="tap detail-link">
                     Visit Sujood ↗
                  </a>
               </div>
               <Image
                  src={sujoodShot}
                  alt="Sujood’s standing position with Arabic recitation, transliteration, and a Listen button."
                  widths={[450, 900]}
                  sizes="(max-width: 700px) calc(100vw - 72px), (max-width: 1024px) calc(100vw - 104px), (max-width: 1360px) calc(58vw - 107px), 688px"
                  class="shot sujood-shot"
               />
            </article>

            <article class="s4 compact-project taskbench-project">
               <div class="stack tight">
                  <span class="ss small-muted">
                     {taskbench.id} · {taskbench.kind}
                  </span>
                  <h4 class="h4">{taskbench.name}</h4>
               </div>
               <p class="ink small">Run your team’s shell tasks in one click.</p>
               <div class="taskbench-file ss">
                  <span>JSON</span>
                  <span>Shared task definitions</span>
               </div>
               <ProjectSource project={taskbench} />
            </article>

            <article class="s4 compact-project ledger-project">
               <div class="stack tight">
                  <span class="ss small-muted">
                     {ledger.id} · {ledger.kind}
                  </span>
                  <h4 class="h4">{ledger.name}</h4>
               </div>
               <p class="ink small">Bookkeeping through slash commands.</p>
               <ul class="ledger-columns ss" aria-label="Ledger features">
                  <li>Balances</li>
                  <li>Inventory</li>
                  <li>History export</li>
               </ul>
               <ProjectSource project={ledger} />
            </article>

            <article class="s4 compact-project site-project">
               <div class="site-lockup">
                  <div class="stack tight">
                     <span class="ss small-muted">{portfolio.id} · This site</span>
                     <h4 class="h4 site-title">{portfolio.name}</h4>
                  </div>
                  <Mark width={40} glow={false} />
               </div>
               <p class="ink small">An Astro portfolio with its own palette, type, and textures.</p>
               <div class="site-palette" aria-hidden="true"></div>
               <div class="site-links">
                  <a href="/system" class="tap strong detail-link">
                     Identity system
                  </a>
                  <ProjectSource project={portfolio} />
               </div>
            </article>
         </div>
      </div>
   </div>

   <ProjectIndex />
</section>

<style>
   .projects {
      position: relative;
      padding-top: 120px;
   }

   .all {
      gap: 10px;
   }

   .features {
      row-gap: 80px;
   }

   .stack {
      display: flex;
      flex-direction: column;
      gap: 12px;
   }

   .tight {
      gap: 6px;
   }

   .h3 {
      font-size: 32px;
      line-height: 1.05;
      letter-spacing: -0.03em;
      font-weight: 600;
   }

   .h4 {
      margin: 0;
      font-size: 26px;
      line-height: 1.12;
      letter-spacing: -0.025em;
      font-weight: 600;
   }

   .ink {
      font-size: 16px;
      line-height: 1.55;
      color: var(--ink);
   }

   .ink.small {
      font-size: 15px;
   }

   .small-muted {
      font-size: 11px;
      color: var(--ink-muted);
   }

   .strong {
      font-size: 15px;
      font-weight: 600;
   }

   .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: 24px;
   }

   .card-dark {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 36px 32px 32px;
      background: var(--graphite);
      color: var(--on-dark);
      clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 32px, 100% 100%, 0 100%);
   }

   .card-dark > :not(.grain-layer) {
      position: relative;
   }

   .row-between {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-size: 11px;
   }

   .muted {
      color: var(--on-dark-muted);
      font-size: 11px;
      line-height: 1.6;
   }

   .stat {
      display: flex;
      align-items: baseline;
      gap: 14px;
      margin-top: auto;
   }

   .bigfig {
      font-size: 88px;
      font-weight: 600;
      letter-spacing: -0.05em;
      line-height: 0.9;
   }

   .wire {
      display: flex;
      align-items: center;
   }

   .wire .muted {
      padding: 0 8px;
      font-size: 10px;
   }

   .node {
      padding: 6px 8px;
      font-size: 10px;
      border: 1px solid var(--violet-glow);
   }

   .node.solid {
      border-color: var(--titanium);
      background: var(--titanium);
      color: var(--graphite);
   }

   .line {
      flex: 1;
      height: 1px;
      background: var(--violet-glow);
   }

   .body {
      display: flex;
      flex-direction: column;
      gap: 10px;
   }

   .body p {
      font-size: 16px;
      line-height: 1.55;
      color: var(--on-dark-soft);
   }

   .disky {
      --source-color: var(--violet-mist);
      --source-hover: var(--on-dark);
      --source-margin: auto;
   }

   .signal-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 22px;
   }

   .trace {
      position: absolute;
      left: 0;
      top: -14px;
      width: 100%;
      height: 10px;
      overflow: visible;
   }

   .sig {
      stroke-dasharray: 28 1400;
      stroke-dashoffset: 28;
      opacity: 0;
      transition:
         stroke-dashoffset var(--dur-signal) var(--ease-signal),
         opacity 160ms;
   }

   .signal-card:hover .sig,
   .signal-card:focus-within .sig {
      stroke-dashoffset: -1100;
      opacity: 1;
   }

   .window {
      position: relative;
      padding: 14px 14px 0;
      background: var(--graphite);
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%);
   }

   .chrome {
      display: flex;
      gap: 6px;
      align-items: center;
      padding-bottom: 10px;
   }

   .light {
      width: 8px;
      height: 8px;
      background: var(--trace-dark);
   }

   .light.lit {
      background: var(--titanium);
   }

   .chrome figcaption {
      margin-left: auto;
      font-size: 9px;
      color: var(--on-dark-muted);
   }

   .tech {
      font-size: 10px;
      line-height: 1.7;
      color: var(--ink);
   }

   .trashy {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(24px, 4vw, 56px);
      align-items: center;
      padding-right: clamp(0px, 2vw, 24px);
   }

   .game-map {
      padding: 12px 12px 0;
      background: #303b33;
      color: #e2e7d8;
      clip-path: polygon(
         0 12px,
         6px 12px,
         6px 6px,
         12px 6px,
         12px 0,
         100% 0,
         100% calc(100% - 12px),
         calc(100% - 6px) calc(100% - 12px),
         calc(100% - 6px) calc(100% - 6px),
         calc(100% - 12px) calc(100% - 6px),
         calc(100% - 12px) 100%,
         0 100%
      );
   }

   .pixelated {
      image-rendering: pixelated;
   }

   .game-map figcaption {
      padding: 11px 0 12px;
      font-size: 10px;
   }

   .game-body {
      align-items: flex-start;
      gap: 16px;
   }

   .h3.game-title {
      max-width: 13ch;
      font-size: clamp(36px, 4.6vw, 64px);
      letter-spacing: -0.045em;
   }

   .game-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 14px 32px;
      width: 100%;
      margin: 4px 0 0;
      padding-top: 14px;
      border-top: 1px solid var(--rule);
   }

   .game-facts dd {
      margin: 4px 0 0;
      font-size: 15px;
      font-weight: 600;
   }

   .cluster {
      display: flex;
      flex-direction: column;
      gap: 32px;
   }

   .cluster-head {
      padding-bottom: 14px;
      border-bottom: 1.5px solid var(--graphite);
   }

   .cluster-title {
      font: inherit;
   }

   .cluster-grid {
      row-gap: 48px;
   }

   .inspect-project {
      grid-column: span 8;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 16px;
   }

   .inspect-header {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
      gap: 12px 24px;
   }

   .inspect-title {
      font-size: clamp(28px, 3.2vw, 46px);
      line-height: 1.05;
      letter-spacing: -0.04em;
   }

   .inspect-preview {
      padding-left: 8px;
      background: linear-gradient(
         to right,
         var(--graphite-deep) 3px,
         var(--violet-signal) 3px 4px,
         var(--graphite-deep) 4px
      );
      border-radius: 4px 0 0 4px;
   }

   .stream-caption {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      color: var(--on-dark-soft);
      font-size: 10px;
      border-bottom: 1px solid var(--trace-dark);
   }

   .stream-caption::before {
      content: "";
      width: 6px;
      height: 6px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--violet-glow);
   }

   .inspect-footer {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0 16px;
      margin-top: -8px;
      border-bottom: 1px solid var(--rule);
   }

   .detail-link {
      align-self: flex-start;
      text-decoration: underline;
      text-underline-offset: 4px;
   }

   .spicetify-project {
      --spicetify-ink: #f5e6d7;
      --spicetify-label: #e0b995;
      --source-color: var(--spicetify-label);
      --source-hover: var(--spicetify-ink);
      border-radius: 0 48px 0 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      min-width: 0;
      background: #382820;
      color: var(--spicetify-ink);
   }

   .spicetify-project > .tight {
      padding: 22px 52px 18px 24px;
      background: repeating-radial-gradient(circle at 100% 0, transparent 0 5px, #77543d 5px 6px)
         right top / 40px 40px no-repeat;
   }

   .spicetify-project .project-meta {
      color: var(--spicetify-label);
      font-size: 11px;
   }

   .spicetify-shot {
      border-block: 1px solid #745341;
   }

   .spicetify-results {
      flex: 1;
      justify-content: space-between;
      padding: 20px 24px 12px;
      gap: 16px;
      font-size: 15px;
      line-height: 1.55;
   }

   .spicetify-performance {
      gap: 12px;
      padding-top: 14px;
      border-top: 1px solid #745341;
   }

   .cpu {
      display: grid;
      grid-template-columns: 50px minmax(0, 1fr) 38px;
      gap: 10px 10px;
      align-items: center;
   }

   .cpu .ss {
      font-size: 10px;
   }

   .track {
      display: block;
      height: 6px;
      background: #644837;
   }

   .fill {
      display: block;
      height: 100%;
   }

   .fill.before {
      width: 50%;
      background: #bc9880;
   }

   .fill.after {
      width: 13%;
      background: #f3b77e;
   }

   .result {
      color: #f3b77e;
   }

   .api-project {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 24px;
      padding: clamp(20px, 3vw, 40px);
      border: 1px solid var(--rule);
      --fold: 26px;
      background:
         linear-gradient(45deg, var(--titanium) 50%, transparent 50%) right top / var(--fold)
            var(--fold) no-repeat,
         color-mix(in srgb, var(--substrate) 48%, var(--ceramic));
      clip-path: polygon(0 0, calc(100% - var(--fold)) 0, 100% var(--fold), 100% 100%, 0 100%);
   }

   .api-title {
      margin-bottom: 6px;
      font-family: var(--font-mono);
      font-size: clamp(26px, 3vw, 42px);
      font-weight: 500;
   }

   .api-scope {
      display: grid;
      gap: 1px;
      margin: 0;
      background: var(--rule);
      border: 1px solid var(--rule);
   }

   .api-scope > div {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 4px 12px;
      padding: 12px 14px;
      background: var(--ceramic);
   }

   .api-scope .approval {
      border-left: 3px solid var(--violet-link);
      padding-left: 11px;
   }

   .api-scope dd {
      margin: 0;
      font-size: 15px;
      font-weight: 600;
   }

   .sujood-project {
      --sujood-ink: #284438;
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 24px;
      background: #e9dfca;
      color: var(--sujood-ink);
      border-left: 6px solid #4b6c59;
      border-radius: 3px 22px 14px 3px;
      box-shadow:
         inset 5px 0 5px -4px #8c7c59,
         inset 0 -2px #b7a987,
         inset 0 -4px #f3ebd9,
         inset 0 -5px #c8bb9c;
   }

   .sujood-body {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 6px 24px;
   }

   .sujood-body .ss {
      font-size: 11px;
   }

   .sujood-title {
      font-size: clamp(44px, 5vw, 68px);
   }

   .sujood-body p {
      max-width: 40ch;
      font-size: 15px;
      line-height: 1.55;
   }

   .sujood-body a {
