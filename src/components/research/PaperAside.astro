---
import { sideNotes } from "@/data/research";
---

<aside class="aside" aria-label="Context">
   {sideNotes.map((note) => (
      <div class="note">
         <span class="ss note-label">{note.label}</span>
         <p class="note-text">{note.text}</p>
      </div>
   ))}
</aside>

<style>
   .aside {
      display: flex;
      flex-direction: column;
      gap: 28px;
      align-self: start;
   }

   .note {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-top: 14px;
      border-top: 1px solid var(--titanium);
   }

   .note:first-child {
      border-top: 1.5px solid var(--graphite);
   }

   .note-label {
      font-size: 10px;
      color: var(--ink-muted);
   }

   .note-text {
      font-size: 15px;
      line-height: 1.55;
      color: var(--ink);
   }
</style>
