---
import { researchMeta, researchPage, study } from "@/data/research";
---

<section class="wrap title-section" aria-labelledby="research-title">
   <div class="intro">
      <span class="ss kicker">
         <span class="id">{study.id}</span>
         <span class="rule" aria-hidden="true"></span>
         {researchPage.kind} · {study.period}
      </span>
      <h1 id="research-title" class="title">
         {study.title}
      </h1>
      <p class="serif lede">{researchPage.lede}</p>
      <a href={study.preprintUrl} class="source-link">
         Read the preprint (PDF) <span aria-hidden="true">↗</span>
      </a>
   </div>

   <dl class="meta">
      {researchMeta.map((item) => (
         <div class="meta-item">
            <dt class="ss meta-label">{item.label}</dt>
            <dd class="meta-value">
               {item.href ? (
                  <a href={item.href} class="source-link">
                     {item.value} <span aria-hidden="true">↗</span>
                  </a>
               ) : (
                  item.value
               )}
            </dd>
         </div>
      ))}
   </dl>
</section>

<style>
   .title-section {
      position: relative;
      padding-top: 72px;
      padding-bottom: 48px;
   }

   .intro {
      display: flex;
      flex-direction: column;
      gap: 24px;
      max-width: 1120px;
   }

   .kicker {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      color: var(--ink-muted);
   }

   .id {
      color: var(--graphite);
   }

   .rule {
      width: 40px;
      height: 1px;
      background: var(--graphite);
   }

   .title {
      font-size: 96px;
      line-height: 0.9;
      letter-spacing: -0.05em;
      font-weight: 600;
   }

   .lede {
      font-size: 36px;
      line-height: 1.18;
      font-style: italic;
      color: var(--ink);
   }

   .meta {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin: 48px 0 0;
      border-top: 1.5px solid var(--graphite);
      border-bottom: 1px solid var(--graphite);
   }

   .meta-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 16px 20px;
   }

   .meta-item:first-child {
      padding-left: 0;
   }

   .meta-item:last-child {
      padding-right: 0;
   }

   .meta-item + .meta-item {
      border-left: 1px solid var(--titanium);
   }

   .meta-label {
      font-size: 10px;
      color: var(--ink-muted);
   }

   .meta-value {
      margin: 0;
      font-size: 16px;
      font-weight: 500;
      overflow-wrap: anywhere;
   }

   .source-link {
      font-weight: 600;
   }

   .intro .source-link {
      align-self: flex-start;
   }

   @media (max-width: 1100px) {
      .title {
         font-size: 72px;
      }
   }

   @media (width > 700px) and (height <= 1240px) {
      .title-section {
         padding-top: 28px;
         padding-bottom: 20px;
      }

      .intro {
         gap: 12px;
      }

      .title {
         font-size: clamp(54px, 6vw, 80px);
      }

      .lede {
         font-size: clamp(26px, 2.5vw, 30px);
      }

      .meta {
         margin-top: 20px;
      }

      .meta-item {
         padding-block: 12px;
      }
   }

   @media (max-width: 700px) {
      .title-section {
         padding-top: 48px;
      }

      .title {
         font-size: 54px;
      }

      .lede {
         font-size: 28px;
      }

      .meta {
         grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .meta-item:nth-child(odd),
      .meta-item + .meta-item:nth-child(odd) {
         padding-left: 0;
         border-left: 0;
      }

      .meta-item:nth-child(even) {
         padding-right: 0;
      }

      .meta-item:nth-child(n + 3) {
         border-top: 1px solid var(--titanium);
      }
   }
</style>
