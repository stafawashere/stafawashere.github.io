---
import PaperSection from "./PaperSection.astro";
import { knobs, knobsSection } from "@/data/research";
---

<PaperSection id="knobs" label={knobsSection.label} title={knobsSection.title}>
   <div role="table" aria-label="The five knobs" class="table">
      <div role="row" class="knob ss head">
         <span role="columnheader">Knob</span>
         <span role="columnheader" class="hide-s">
            In the model
         </span>
         <span role="columnheader">Brain variable</span>
         <span role="columnheader" class="hide-s">
            At the peak
         </span>
      </div>
      {knobs.map((knob) => (
         <div role="row" class="knob row">
            <span role="cell" class="ss name">
               {knob.name}
            </span>
            <span role="cell" class="hide-s in-model">
               {knob.inModel}
            </span>
            <span role="cell" class="brain">
               {knob.brainVariable}
            </span>
            <span role="cell" class="hide-s ss at-peak">
               {knob.atPeak}
            </span>
         </div>
      ))}
   </div>
</PaperSection>

<style>
   .table {
      display: flex;
      flex-direction: column;
      margin-top: 4px;
      border-top: 1.5px solid var(--graphite);
   }

   .knob {
      display: grid;
      grid-template-columns: 150px minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 0.8fr);
      column-gap: 18px;
   }

   .head {
      padding: 12px 0;
      border-bottom: 1px solid var(--graphite);
      font-size: 10px;
      color: var(--ink-muted);
   }

   .row {
      align-items: baseline;
      padding: 14px 0;
      border-bottom: 1px solid var(--titanium);
      font-size: 15px;
      line-height: 1.45;
   }

   .name {
      font-size: 11px;
      color: var(--graphite);
      text-transform: none;
      overflow-wrap: anywhere;
   }

   .in-model {
      color: var(--ink);
   }

   .brain {
      font-weight: 500;
   }

   .at-peak {
      font-size: 11px;
      color: var(--violet-link);
      text-transform: none;
   }

   @media (max-width: 700px) {
      .knob {
         grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
         row-gap: 4px;
      }

      .hide-s {
         display: none;
      }
   }
</style>
