---
import PaperSection from "./PaperSection.astro";
import { rules, rulesSection } from "@/data/research";
---

<PaperSection id="rules" label={rulesSection.label} title={rulesSection.title}>
   <ol class="rules">
      {rules.map((rule) => (
         <li class="rule">
            <span class="ss index">{rule.index}</span>
            <span>{rule.text}</span>
         </li>
      ))}
   </ol>
</PaperSection>

<style>
   .rules {
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1.5px solid var(--graphite);
   }

   .rule {
      display: grid;
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 12px;
      padding: 14px 0;
      border-bottom: 1px solid var(--titanium);
      font-size: 16px;
      line-height: 1.55;
   }

   .index {
      font-size: 11px;
      color: var(--violet-link);
   }
</style>
