---
import PaperSection from "./PaperSection.astro";
import { findingSection } from "@/data/research";
---

<PaperSection
   id="finding"
   label={findingSection.label}
   title={findingSection.title}
   paragraphs={findingSection.paragraphs}
>
   <dl class="stats">
      {findingSection.stats.map((stat) => (
         <div class="stat">
            <dt class="ss stat-label">{stat.label}</dt>
            <dd class="stat-value">
               {stat.value} <span class="comparison">{stat.comparison}</span>
            </dd>
         </div>
      ))}
   </dl>
</PaperSection>

<style>
   .stats {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      border-top: 1.5px solid var(--graphite);
      border-bottom: 1px solid var(--graphite);
   }

   .stat {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 20px 20px 20px 0;
   }

   .stat + .stat {
      padding: 20px 0 20px 20px;
      border-left: 1px solid var(--titanium);
   }

   .stat-label {
      font-size: 10px;
      color: var(--ink-muted);
   }

   .stat-value {
      margin: 0;
      font-size: 40px;
      font-weight: 600;
      letter-spacing: -0.03em;
   }

   .comparison {
      font-size: 18px;
      font-weight: 500;
      color: var(--ink-muted);
      letter-spacing: normal;
   }

   @media (max-width: 700px) {
      .stat-value {
         font-size: 32px;
      }

      .comparison {
         display: block;
         font-size: 15px;
      }
   }
</style>
