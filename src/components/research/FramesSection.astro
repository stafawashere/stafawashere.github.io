---
import { Image } from "astro:assets";
import { plotSeries, toPathData } from "@/lib/chart";
import { LAST_FRAME, figureFrames, researchPage, rmseSeries } from "@/data/research";

const box = { width: 1000, baseline: 260, top: 20 };
const gridValues = [0.1, 0.2];

const points = plotSeries(
   rmseSeries.map((sample) => ({ x: sample.frame, y: sample.rmse })),
   box,
);
const pathData = toPathData(points);

const peakSample = rmseSeries.reduce((best, sample) => (sample.rmse > best.rmse ? sample : best));
const peakIndex = rmseSeries.indexOf(peakSample);
const peakPoint = points[peakIndex];
const markerPoints = points.filter((_, index) => index > 0 && index !== peakIndex);

const yScale = (box.baseline - box.top) / peakSample.rmse;
const gridLines = gridValues.map((value) => ({
   label: value.toFixed(2),
   y: Math.round((box.baseline - value * yScale) * 10) / 10,
}));

const frameLabel = (frame: number) => `F${String(frame).padStart(2, "0")}`;
const peakX = (peakSample.frame / LAST_FRAME) * box.width;

const formatRmse = (rmse: number) => (rmse === 0 ? "0" : rmse.toFixed(3));
const chartSummary = rmseSeries
   .map((sample, index) => {
      const isFirst = index === 0;
      const isPeak = sample === peakSample;
      const value = formatRmse(sample.rmse);

      if (isFirst) {
         return `${value} at frame ${sample.frame}`;
      }

      return isPeak ? `peak ${value} at ${sample.frame}` : `${value} at ${sample.frame}`;
   })
   .join(", ");

const rmseAt = (frame: number) => rmseSeries.find((sample) => sample.frame === frame)?.rmse ?? 0;
---

<section class="on-dark frames-band" aria-label="Key frames and RMSE over the run">
   <div class="grain grain-layer" aria-hidden="true"></div>

   <div class="wrap inner">
      <div class="frames">
         {figureFrames.map((frame) => (
            <figure class:list={["frame", { peak: frame.peak }]}>
               <Image
                  src={frame.src}
                  alt={frame.alt}
                  width={512}
                  height={512}
                  class="shot"
                  sizes="(max-width: 700px) 100vw, 33vw"
               />
               <figcaption class="ss frame-caption">
                  <span>
                     {frame.figure} · {frame.caption}
                  </span>
                  <span>RMSE {rmseAt(frame.frame).toFixed(3)}</span>
               </figcaption>
            </figure>
         ))}
      </div>

      <figure class="chart">
         <svg
            viewBox={`0 0 ${box.width} 290`}
            role="img"
            aria-label={`RMSE of each frame against frame 0: ${chartSummary}.`}
         >
            <path class="axis" d={`M0 ${box.baseline}H${box.width}`}></path>
            {gridLines.map((line) => (
               <path class="grid-line" d={`M0 ${line.y}H${box.width}`} />
            ))}

            <g class="tick">
               {gridLines.map((line) => (
                  <text x="0" y={line.y - 6.4}>
                     {line.label}
                  </text>
               ))}
               <text x="0" y="284">
                  {frameLabel(0)}
               </text>
               <text x={peakX} y="284" text-anchor="middle">
                  {frameLabel(peakSample.frame)}
               </text>
               <text x={box.width} y="284" text-anchor="end">
                  {frameLabel(LAST_FRAME)}
               </text>
            </g>

            <path class="series" d={pathData}></path>

            <g class="marker">
               {markerPoints.map((point) => (
                  <circle cx={point.x} cy={point.y} r="4" />
               ))}
            </g>

            {peakPoint && (
               <>
                  <circle class="peak-dot" cx={peakPoint.x} cy={peakPoint.y} r="6" />
                  <text class="peak-label" x={peakPoint.x + 12.7} y={peakPoint.y + 4}>
                     {researchPage.peakLabel}
                  </text>
               </>
            )}
         </svg>
         <figcaption class="ss chart-caption">{researchPage.rmseCaption}</figcaption>
      </figure>
   </div>
</section>

<style>
   .frames-band {
      position: relative;
   }

   .inner {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 28px;
      padding-top: 56px;
      padding-bottom: 56px;
   }

   .frames {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
   }

   .frame,
   .chart {
      display: flex;
      flex-direction: column;
      gap: 10px;
   }

   .frame :global(img) {
      box-shadow: 0 0 0 1px var(--trace-dark);
   }

   .frame.peak :global(img) {
      box-shadow: 0 0 0 1px var(--violet-glow);
   }

   .frame-caption {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      font-size: 10px;
      color: var(--on-dark-muted);
   }

   .peak .frame-caption {
      color: var(--on-dark);
   }

   .chart svg {
      display: block;
      width: 100%;
      height: auto;
      overflow: visible;
   }

   .axis,
   .grid-line {
      stroke: #4b4163;
      stroke-width: 1;
   }

   .grid-line {
      stroke-dasharray: 2 6;
   }

   .tick {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 1px;
      fill: var(--on-dark-muted);
   }

   .series {
      fill: none;
      stroke: var(--violet-glow);
      stroke-width: 2;
      stroke-linejoin: round;
   }

   .marker {
      fill: var(--graphite);
      stroke: var(--violet-glow);
      stroke-width: 1.5;
   }

   .peak-dot {
      fill: var(--violet-glow);
   }

   .peak-label {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 1px;
      fill: var(--on-dark);
   }

   .chart-caption {
      font-size: 10px;
      color: var(--on-dark-muted);
   }

   @media (max-width: 700px) {
      .inner {
         padding-top: 40px;
         padding-bottom: 40px;
      }

      .frames {
         grid-template-columns: 1fr;
      }

      .tick {
         font-size: 22px;
      }

      .peak-label {
         font-size: 22px;
      }
   }
</style>
