{
   "name": "lunar-lavender",
   "version": "0.1.0",
   "private": true,
   "type": "module",
   "description": "Personal site of Mahfuj Mustafa, built with Astro.",
   "engines": {
      "node": ">=22"
   },
   "scripts": {
      "dev": "astro dev",
      "build": "astro check && astro build",
      "preview": "astro preview",
      "check": "astro check",
      "lint": "eslint .",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "vitest run",
      "verify": "npm run lint && npm run format:check && npm run test && npm run build"
   },
   "dependencies": {
      "@fontsource/geist-mono": "^5.3.0",
      "@fontsource/instrument-serif": "^5.3.0",
      "@fontsource/inter-tight": "^5.3.0",
      "astro": "^7.4.13"
   },
   "devDependencies": {
      "@astrojs/check": "^0.9.12",
      "@eslint/js": "^10.0.1",
      "@types/node": "^22.20.7",
      "eslint": "^10.15.0",
      "eslint-plugin-astro": "^3.2.2",
      "globals": "^17.14.0",
      "prettier": "^3.10.1",
      "prettier-plugin-astro": "^1.1.2",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.74.0",
      "vitest": "^5.1.2"
   }
}
